$TTL 2d

$ORIGIN home.matthomelab.xyz.

@               IN      SOA     ns.home.matthomelab.xyz. info.matthomelab.xyz. (
                                2026110100  ; serial
                                12h ; refresh
                                15m ; retry
                                3w  ; expire
                                2h  ; minimum ttl
                                )

                IN      NS      ns.home.matthomelab.xyz.

ns              IN      A       192.168.1.145

; -- add dns records below

*                  A       10.10.0.1
